{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "2048",
  "version": "1.0.0",
  "identifier": "com.github.avibarit.2048",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": "mkdir -p dist && cp index.html styles.css game.js dist/"
  },
  "app": {
    "windows": [
      {
        "title": "2048",
        "width": 560,
        "height": 800,
        "minWidth": 320,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "PuzzleGame",
    "shortDescription": "Classic 2048 puzzle game",
    "longDescription": "Exact classic clone of 2048. Join tiles to reach 2048. Native desktop build with Tauri.",
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
