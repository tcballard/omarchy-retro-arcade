# Build from a clean checkout with packaging/build-arch.sh.
pkgname=omarchy-retro-arcade
pkgver=0.2.0
pkgrel=1
pkgdesc='Native games in one Omarchy Arcade application'
arch=('x86_64' 'aarch64')
url='https://github.com/tcballard/omarchy-retro-arcade'
license=('GPL-3.0-or-later')
# ring's bundled C objects cannot use GCC LTO with Rust's LLVM linker.
# https://wiki.archlinux.org/title/Rust_package_guidelines#Package
options=('!lto')
depends=('gcc-libs' 'glibc' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'libglvnd' 'wayland' 'xdg-desktop-portal' 'libpulse' 'sdl2' 'sdl2_image' 'sdl2_mixer')
conflicts=('omarchy-chess' 'omarchy-solitaire' 'omarchy-scram' 'omarchy-munch' 'omarchy-invaders' 'omarchy-spacecadet')
optdepends=('xdg-desktop-portal-gtk: file chooser fallback')
makedepends=('rust>=1.98' 'pkgconf' 'cmake' 'python')
_engine_commit=59aae690f91d6f69aac194f447d84b4a2c3be778
source=('omarchy-retro-arcade-source.tar.gz'
        "stockfish-${_engine_commit}.tar.gz::https://codeload.github.com/official-stockfish/Stockfish/tar.gz/${_engine_commit}"
        'https://tests.stockfishchess.org/api/nn/nn-1a298aa575a0.nnue')
# Only the app snapshot checksum is filled by build-arch.sh.
sha256sums=('SKIP'
            '85bc210f6a4fc98759fbc1a6bfd8b5a25bed9dafa6d5959008c0dbe20fc7848d'
            '1a298aa575a085434d29027978dc36867fe9c5bcea9376654b7a8eba1e52dfc2')
prepare() {
  cp "$srcdir/nn-1a298aa575a0.nnue" "$srcdir/Stockfish-${_engine_commit}/src/"
  cd "$srcdir/omarchy-retro-arcade"
  cargo fetch --locked
}
build() {
  cd "$srcdir/Stockfish-${_engine_commit}/src"
  local engine_arch=x86-64
  [[ $CARCH != aarch64 ]] || engine_arch=armv8
  make -j2 build ARCH="$engine_arch" COMP=gcc
  cd "$srcdir/omarchy-retro-arcade"
  scripts/build.sh
}
check() {
  cd "$srcdir/omarchy-retro-arcade"
  OMARCHY_CHESS_ENGINE="$srcdir/Stockfish-${_engine_commit}/src/stockfish" REQUIRE_STOCKFISH=1 cargo test --frozen --workspace --all-targets
  ctest --test-dir build/pinball --output-on-failure -R "theme-palette|theme-path|authored-"
}
package() {
  cd "$srcdir/omarchy-retro-arcade"
  scripts/install.sh "$pkgdir"
  install -Dm755 "$srcdir/Stockfish-${_engine_commit}/src/stockfish" "$pkgdir/usr/libexec/omarchy-retro-arcade/stockfish"
  install -Dm644 "$srcdir/Stockfish-${_engine_commit}/Copying.txt" "$pkgdir/usr/share/licenses/$pkgname/Stockfish.txt"
}
